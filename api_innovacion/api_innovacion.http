POST {{host}}/api/activ_academica
Content-Type: application/json

{
  "id": 602,
  "nombre": "Actividad X",
  "num_creditos": 2,
  "tipo": "Curso",
  "area_formacion": "Disciplinar",
  "h_acom": 2,
  "h_indep": 2,
  "idioma": "Español",
  "espejo": 0,
  "entidad_espejo": "N/A",
