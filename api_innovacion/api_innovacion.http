  "descripcion": "Reconocimiento internacional",
  "fecha": "2021-05-10",
  "entidad_otorgante": "UNESCO",
  "pais": "Francia",
  "programa": 10
}

### Actualizar parcial (PATCH) premio 300 — 200
PATCH {{host}}/api/premio/300
Content-Type: application/json

{
  "pais": "Suiza"
}

### Eliminar (DELETE) premio 300 — 200
DELETE {{host}}/api/premio/300

### Segundo DELETE premio 300 — 404
DELETE {{host}}/api/premio/300

### FALLA: FK inexistente (programa 99999) — 409
POST {{host}}/api/premio
Content-Type: application/json

{
  "id": 301,
  "nombre": "Premio X",
  "descripcion": "Prueba",
  "fecha": "2020-11-20",
  "entidad_otorgante": "MEN",
  "pais": "Colombia",
  "programa": 99999
}


# =============================================================================
# Issue #2 (Valentina): programa, acreditacion, registro_calificado,
# activ_academica y las puentes enfoque_rc y aa_rc.
#
# Si partes de una base recién creada, ejecuta PRIMERO los puntos 5.1 y 5.2 de
# esta sección (crean la facultad 110 y el programa 10): las secciones 3 y 4 de
# arriba asumen ese programa. Al final del bloque de acreditación se demuestra
# el disparador (el contador del programa cambia solo al asignar y retirar).
# =============================================================================


# -----------------------------------------------------------------------------
# 5. programa (maestro central)
# -----------------------------------------------------------------------------

### Listar programas
GET {{host}}/api/programa?limite=100
Accept: application/json

### Obtener programa 10
GET {{host}}/api/programa/10
Accept: application/json

### 5.1 Crear facultad 110 (la facultad 100 quedó retirada en la sección 2) — 200
POST {{host}}/api/facultad
Content-Type: application/json

{
  "id": 110,
  "nombre": "Facultad de Ingeniería",
  "tipo": "Pública",
  "fecha_fun": "1960-03-15",
  "universidad": 1
}

### 5.2 Crear programa 10 — 200 (devuelve la fila; num_acreditaciones arranca en 0)
POST {{host}}/api/programa
Content-Type: application/json

{
  "id": 10,
  "nombre": "Ingeniería de Sistemas",
  "tipo": "Profesional",
  "nivel": "Pregrado",
  "fecha_creacion": "2001-02-01",
  "fecha_cierre": null,
  "numero_cohortes": "24",
  "cant_graduados": "320",
  "fecha_actualizacion": "2025-01-15",
  "ciudad": "Medellín",
  "facultad": 110
}

### Reemplazar (PUT) programa 10 — 200
PUT {{host}}/api/programa/10
Content-Type: application/json

{
  "nombre": "Ingeniería de Sistemas",
  "tipo": "Profesional",
  "nivel": "Pregrado",
  "fecha_creacion": "2001-02-01",
  "fecha_cierre": "2030-12-31",
  "numero_cohortes": "26",
  "cant_graduados": "330",
  "fecha_actualizacion": "2025-06-30",
  "ciudad": "Medellín",
  "facultad": 110
}

### Actualizar parcial (PATCH) programa 10 — 200
PATCH {{host}}/api/programa/10
Content-Type: application/json

{
  "ciudad": "Bogotá"
}

### FALLA: FK inexistente (facultad 99999) — 409
POST {{host}}/api/programa
Content-Type: application/json

{
  "id": 11,
  "nombre": "Programa X",
  "tipo": "Profesional",
  "nivel": "Pregrado",
  "fecha_creacion": "2010-01-01",
  "numero_cohortes": "10",
  "cant_graduados": "50",
  "fecha_actualizacion": "2025-01-01",
  "ciudad": "Medellín",
  "facultad": 99999
}

### FALLA: body inválido (nombre vacío) — 422
POST {{host}}/api/programa
Content-Type: application/json

{
  "id": 12,
  "nombre": "",
  "tipo": "Profesional",
  "nivel": "Pregrado",
  "fecha_creacion": "2010-01-01",
  "numero_cohortes": "10",
  "cant_graduados": "50",
  "fecha_actualizacion": "2025-01-01",
  "ciudad": "Medellín",
  "facultad": 110
}

### FALLA: PATCH sin campos — 400
PATCH {{host}}/api/programa/10
Content-Type: application/json

{}

### FALLA: recurso inexistente — 404
GET {{host}}/api/programa/999999
Accept: application/json


# -----------------------------------------------------------------------------
# 6. acreditacion (detalle de programa; aquí se demuestra el DISPARADOR)
# -----------------------------------------------------------------------------

### Listar acreditaciones
GET {{host}}/api/acreditacion?limite=100
Accept: application/json

### Crear acreditación 400 — 200 (devuelve la fila)
POST {{host}}/api/acreditacion
Content-Type: application/json

{
  "resolucion": 400,
  "tipo": "Nacional",
  "calificacion": "Alta calidad",
  "fecha_inicio": "2020-01-01",
  "fecha_fin": "2024-01-01",
  "programa": 10
}

### Disparador 1/2: el contador del programa 10 debe subir SOLO (num_acreditaciones = 1)
GET {{host}}/api/programa/10
Accept: application/json

### Obtener acreditación 400
GET {{host}}/api/acreditacion/400
Accept: application/json

### Reemplazar (PUT) acreditación 400 — 200
PUT {{host}}/api/acreditacion/400
Content-Type: application/json

{
  "tipo": "Internacional",
  "calificacion": "Excelente",
  "fecha_inicio": "2021-01-01",
  "fecha_fin": "2025-01-01",
  "programa": 10
}

### Actualizar parcial (PATCH) acreditación 400 — 200
PATCH {{host}}/api/acreditacion/400
Content-Type: application/json

{
  "calificacion": "Superior"
}

### FALLA: PK duplicada (repetir el POST de la 400) — 409
POST {{host}}/api/acreditacion
Content-Type: application/json

{
  "resolucion": 400,
  "tipo": "Nacional",
  "calificacion": "Alta calidad",
  "fecha_inicio": "2020-01-01",
  "fecha_fin": "2024-01-01",
  "programa": 10
}

### FALLA: FK inexistente (programa 99999) — 409
POST {{host}}/api/acreditacion
Content-Type: application/json

{
  "resolucion": 401,
  "tipo": "Nacional",
  "calificacion": "Alta calidad",
  "fecha_inicio": "2020-01-01",
  "fecha_fin": "2024-01-01",
  "programa": 99999
}

### FALLA: body inválido (fecha_fin vacía) — 422
POST {{host}}/api/acreditacion
Content-Type: application/json

{
  "resolucion": 402,
  "tipo": "Nacional",
  "calificacion": "Alta calidad",
  "fecha_inicio": "2020-01-01",
  "fecha_fin": "",
  "programa": 10
}

### FALLA: retirar el programa 10 con la acreditación 400 activa — 409
DELETE {{host}}/api/programa/10

### Eliminar (DELETE) acreditación 400 — 200
DELETE {{host}}/api/acreditacion/400

### Disparador 2/2: el contador del programa 10 debe bajar SOLO (num_acreditaciones = 0)
# Esta es la prueba del tropiezo 6: retirar es un UPDATE y el disparador lo escucha.
GET {{host}}/api/programa/10
Accept: application/json

### FALLA: segundo DELETE de la acreditación 400 — 404
DELETE {{host}}/api/acreditacion/400


# -----------------------------------------------------------------------------
# 7. registro_calificado (PK codigo; fechas DATE; padre de enfoque_rc y aa_rc)
# -----------------------------------------------------------------------------

### Listar registros calificados
GET {{host}}/api/registro_calificado?limite=100
Accept: application/json

### Crear registro calificado 500 — 200 (queda activo: lo usan las puentes)
POST {{host}}/api/registro_calificado
Content-Type: application/json

{
  "codigo": 500,
  "cant_creditos": "160",
  "hora_acom": "20",
  "hora_ind": "30",
  "metodologia": "Presencial",
  "fecha_inicio": "2020-01-15",
  "fecha_fin": "2024-01-15",
  "duracion_anios": "4",
  "duracion_semestres": "8",
  "tipo_titulacion": "Profesional",
  "programa": 10
}

### Obtener registro calificado 500
GET {{host}}/api/registro_calificado/500
Accept: application/json

### Reemplazar (PUT) registro calificado 500 — 200
PUT {{host}}/api/registro_calificado/500
Content-Type: application/json

{
  "cant_creditos": "170",
  "hora_acom": "22",
  "hora_ind": "28",
  "metodologia": "Híbrida",
  "fecha_inicio": "2021-01-15",
  "fecha_fin": "2025-01-15",
  "duracion_anios": "4",
  "duracion_semestres": "8",
  "tipo_titulacion": "Profesional",
  "programa": 10
}

### Actualizar parcial (PATCH) registro calificado 500 — 200
PATCH {{host}}/api/registro_calificado/500
Content-Type: application/json

{
  "duracion_anios": "5"
}

### Crear registro calificado 501 (para el ciclo de borrado) — 200
POST {{host}}/api/registro_calificado
Content-Type: application/json

{
  "codigo": 501,
  "cant_creditos": "120",
  "hora_acom": "15",
  "hora_ind": "25",
  "metodologia": "Virtual",
  "fecha_inicio": "2022-01-15",
  "fecha_fin": "2026-01-15",
  "duracion_anios": "4",
  "duracion_semestres": "8",
  "tipo_titulacion": "Tecnólogo",
  "programa": 10
}

### Eliminar (DELETE) registro calificado 501 — 200
DELETE {{host}}/api/registro_calificado/501

### FALLA: segundo DELETE del registro 501 — 404
DELETE {{host}}/api/registro_calificado/501

### FALLA: FK inexistente (programa 99999) — 409
POST {{host}}/api/registro_calificado
Content-Type: application/json

{
  "codigo": 502,
  "cant_creditos": "120",
  "hora_acom": "15",
  "hora_ind": "25",
  "metodologia": "Virtual",
  "fecha_inicio": "2022-01-15",
  "fecha_fin": "2026-01-15",
  "duracion_anios": "4",
  "duracion_semestres": "8",
  "tipo_titulacion": "Tecnólogo",
  "programa": 99999
}

### FALLA: body inválido (codigo no positivo) — 422
POST {{host}}/api/registro_calificado
Content-Type: application/json

{
  "codigo": 0,
  "cant_creditos": "120",
  "hora_acom": "15",
  "hora_ind": "25",
  "metodologia": "Virtual",
  "fecha_inicio": "2022-01-15",
  "fecha_fin": "2026-01-15",
  "duracion_anios": "4",
  "duracion_semestres": "8",
  "tipo_titulacion": "Tecnólogo",
  "programa": 10
}


# -----------------------------------------------------------------------------
# 8. activ_academica (la única FK OPCIONAL: disenio -> «(ninguna)» = null)
# -----------------------------------------------------------------------------

