  "nombre": "Cátedra de innovación",
  "num_creditos": 3,
  "tipo": "Curso",
  "area_formacion": "Sociohumanística",
  "h_acom": 4,
  "h_indep": 5,
  "idioma": "Español",
  "espejo": 0,
  "entidad_espejo": "N/A",
  "pais_espejo": "N/A",
  "disenio": null
}

