# -----------------------------------------------------------------------------
# 9. enfoque_rc (puente: asignar y retirar; SIN PUT ni PATCH)
# -----------------------------------------------------------------------------

### Crear un enfoque 900 (tabla de la v1) para la pareja — 200
POST {{host}}/api/enfoque
Content-Type: application/json

{
  "id": 900,
  "nombre": "Enfoque de prueba",
  "descripcion": "Para la puente enfoque_rc"
}

### Listar enfoques del registro
GET {{host}}/api/enfoque_rc?limite=100
Accept: application/json

### Asignar la pareja (900, 500) — 200 (devuelve la pareja con los nombres)
POST {{host}}/api/enfoque_rc
Content-Type: application/json

{
  "enfoque": 900,
  "registro_calificado": 500
}

### Obtener la pareja (900, 500)
GET {{host}}/api/enfoque_rc/900/500
Accept: application/json

### FALLA: pareja repetida — 409
POST {{host}}/api/enfoque_rc
Content-Type: application/json

{
  "enfoque": 900,
  "registro_calificado": 500
}

### FALLA: enfoque inexistente — 409
POST {{host}}/api/enfoque_rc
Content-Type: application/json

{
  "enfoque": 99999,
  "registro_calificado": 500
}

### FALLA: registro calificado inexistente — 409
POST {{host}}/api/enfoque_rc
Content-Type: application/json

{
  "enfoque": 900,
  "registro_calificado": 99999
}

### FALLA: body inválido (falta registro_calificado) — 422
POST {{host}}/api/enfoque_rc
Content-Type: application/json

{
  "enfoque": 900
}

### FALLA: retirar el registro calificado 500 con la pareja activa — 409
DELETE {{host}}/api/registro_calificado/500

### Retirar la pareja (900, 500) — 200
DELETE {{host}}/api/enfoque_rc/900/500

### FALLA: retirar la pareja otra vez — 404
DELETE {{host}}/api/enfoque_rc/900/500


# -----------------------------------------------------------------------------
# 10. aa_rc (puente con atributos: componente y semestre)
# -----------------------------------------------------------------------------

### Listar actividades del registro
GET {{host}}/api/aa_rc?limite=100
Accept: application/json

### Asignar la pareja (600, 500) con componente y semestre — 200
POST {{host}}/api/aa_rc
Content-Type: application/json

{
  "activ_academicas_idcurso": 600,
  "registro_calificado_codigo": 500,
  "componente": "Investigación",
  "semestre": "2025-1"
}

### Obtener la pareja (600, 500)
GET {{host}}/api/aa_rc/600/500
Accept: application/json

### FALLA: pareja repetida — 409
POST {{host}}/api/aa_rc
Content-Type: application/json

{
  "activ_academicas_idcurso": 600,
  "registro_calificado_codigo": 500,
  "componente": "Investigación",
  "semestre": "2025-1"
}

### FALLA: actividad académica inexistente — 409
POST {{host}}/api/aa_rc
Content-Type: application/json

{
  "activ_academicas_idcurso": 99999,
  "registro_calificado_codigo": 500,
  "componente": "Investigación",
  "semestre": "2025-1"
}

### FALLA: body inválido (falta componente) — 422
POST {{host}}/api/aa_rc
